# ThumbsUp Email API settings. Copy to `.env` and fill in. Never commit .env.
# The server REFUSES TO START if something required is missing, and tells you what.

# development = your laptop | production = live server (stricter security checks)
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8001

# Random string, 32+ characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
COOKIE_SECURE=false

# Frontend(s) allowed to use the dashboard, comma separated
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Laptop: SQLite file. Production: PostgreSQL
DATABASE_URL=sqlite:///./storage/thumbsup.db
# DATABASE_URL=postgresql+psycopg://thumbsup:password@localhost:5432/thumbsup

# ======================= EMAIL DELIVERY (required) =======================
# Option C (handy on a laptop for testing): SMTP, works with Gmail / Google Workspace / Microsoft 365 / Zoho / Brevo / SES-SMTP
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
# Gmail: create an App Password at https://myaccount.google.com/apppasswords (needs 2-Step Verification)
SMTP_PASSWORD=
# Must be an address your SMTP account is allowed to send from (for Gmail: the same Gmail address)
DEFAULT_FROM_EMAIL=
DEFAULT_FROM_NAME=ThumbsUp Email

# Option A (on Azure, recommended): Azure Communication Services Email.
# EMAIL_PROVIDER=acs
# ACS_ENDPOINT=https://viacodos-email.communication.azure.com   # with the app's managed identity (no password)
# ACS_CONNECTION_STRING=                # ...or a connection string instead
# DEFAULT_FROM_EMAIL=DoNotReply@viacodos.com                     # a sender address of the connected email domain
# ACS_EVENTS_TOKEN=                     # random; Event Grid posts delivery reports to /v1/providers/acs/events/<this token>

# Option B: Amazon SES API.
# Customers can send from their own verified domains, and bounces/complaints are tracked.
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=          # leave empty when the server has an IAM role
# AWS_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=thumbsup-events
# SES_EVENTS_TOKEN=           # random string; SNS posts to /v1/providers/ses/events/<this token>

# ======================= DRIVE ASSETS (optional) =======================
# Google service account ("robot") that clients share their folders with. See README > Drive Assets.
# GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
# Public address for website files (defaults to PUBLIC_BASE_URL), e.g. https://assets.viacodos.com
# ASSETS_BASE_URL=
# Copies of Drive files: local (one server only), s3 (Amazon S3 / Cloudflare R2) or azure (Azure Blob Storage)
ASSET_STORAGE=local
# Azure Blob Storage. Recommended on Azure: managed identity, no secret here
# (give the app the "Storage Blob Data Contributor" role on the storage account)
# AZURE_STORAGE_ACCOUNT_URL=https://viacodosassets.blob.core.windows.net
# AZURE_STORAGE_CONNECTION_STRING=      # or a connection string instead
# AZURE_STORAGE_CONTAINER=thumbsup-assets
# S3_BUCKET=thumbsup-assets
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
ASSET_MAX_FILE_MB=300
ASSET_DELETE_GRACE_MINUTES=30
ASSET_CACHE_SECONDS=60

# ======================= SHEETS (Google Sheets as a database, optional) =======================
# "Sign in with Google": Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <PUBLIC_BASE_URL>/dashboard/sheets/google/callback
# Only the drive.file permission is used (non-sensitive): ThumbsUp sees only sheets created or picked through it.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=            # defaults to PUBLIC_BASE_URL + /dashboard/sheets/google/callback
# Where people return after Google sign-in (the Codos Console page with ThumbsUp). Defaults to <first DASHBOARD_ORIGINS>/console
# DASHBOARD_URL=https://console.viacodos.com/console
# Encrypts customers' Google tokens. 32+ random characters, different from JWT_SECRET. Azure: keep it in Key Vault.
# DATA_ENCRYPTION_KEY=
# Optional "pick an existing sheet" button: an API key restricted to the Picker API + the project NUMBER
# GOOGLE_PICKER_API_KEY=
# GOOGLE_CLOUD_PROJECT_NUMBER=
# "Share your sheet with our robot email" also works when the Drive Assets service account is set up
SHEETS_ROBOT_ENABLED=true
SHEETS_CACHE_SECONDS=30
SHEETS_WRITES_PER_MINUTE=50

# ======================= DELIVERY QUEUE =======================
WORKER_ENABLED=true
MAX_DELIVERY_ATTEMPTS=6

# ======================= LIMITS =======================
MAX_RECIPIENTS=50
MAX_FILE_MB=25
MAX_INLINE_ATTACHMENTS_MB=8
DOWNLOAD_LINK_DAYS=7
PUBLIC_FORM_RATE_PER_MINUTE=10
SECRET_KEY_RATE_PER_MINUTE=120
LOGIN_RATE_PER_MINUTE=10
LOGIN_FAILURES_PER_ACCOUNT=10
MAX_REQUEST_MB=40
# Reverse proxies in front of the API (Nginx/Caddy/Cloudflare = 1, Cloudflare + Nginx = 2)
TRUSTED_PROXY_HOPS=1
