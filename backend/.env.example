# Copy to .env (ignored by Git). Use the same DB password in postgres-env.example.
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-url-safe-random-password@localhost:5433/skybeak_db

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key
MARKETPLACE_ADMIN_TOKEN=replace-with-a-long-random-admin-token
MARKETPLACE_GATEWAY_BASE_URL=http://localhost:8000/api/v1/gateway
INFERENCE_MODE=mock_dev
