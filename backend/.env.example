# Copy to .env (ignored by Git). Use the same DB password in postgres-env.example.
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-url-safe-random-password@localhost:5433/skybeak_db

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key
INFERENCE_MODE=mock_dev

# CallColleague.ai (Vapi Voice AI + Webhooks)
VAPI_PRIVATE_API_KEY=paste-your-vapi-private-key-here
VAPI_PUBLIC_KEY=paste-your-vapi-public-key-here
VAPI_WEBHOOK_SECRET=whsec_call_colleague_dev_secret
APP_PUBLIC_URL=http://localhost:8000

# CallColleague.ai Google Calendar OAuth (create a Web OAuth client in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
FRONTEND_URL=http://localhost:3000

# CallColleague.ai Twilio Telephony (optional; uses sandbox number preview if blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_BUNDLE_SID_GB=
TWILIO_BUNDLE_SID_AU=
TWILIO_DRY_RUN=false
